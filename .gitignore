# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
.venv/
.venv-windows/
venv/
env/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Environment variables / secrets
.env
.env.*

# Collected data (screen-resolution/game-specific, not source)
data/

# Per-machine config overrides (e.g. config/regions.local.json)
config/*.local.json
assets/templates.local/

# Runtime logs
*.log

# Editors / OS
.vscode/
.idea/
.DS_Store

# Personal Claude Code settings (e.g. local hooks) - not shared with the team
.claude/settings.local.json
.claude/hooks/
